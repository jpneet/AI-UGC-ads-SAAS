# PostgreSQL Database connection URL
DATABASE_URL=

# Clerk Authentication Keys
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# Cloudinary Storage Configurations
CLOUDINARY_URL=

# Optional Hugging Face Token for Image Fallback (omitting will use Pollinations.ai)
HUGGINGFACE_API_KEY=

# Sentry Monitoring DSN
SENTRY_DSN=

# Allowed CORS Origins (comma-separated, e.g. http://localhost:5173)
ALLOWED_ORIGINS=

# Payment provider Webhook Secret (optional for sandbox mode)
PAYMENT_WEBHOOK_SECRET=

# Custom path to a TrueType font for FFmpeg drawtext (optional)
FFMPEG_FONT_PATH=
